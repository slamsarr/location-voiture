# ============================================================
# HERTZ DIGITAL — Variables d'environnement Supabase
# ============================================================
# Copier ce fichier en : backend/.env
# Remplacez [PROJECT_REF], [PASSWORD], [REGION] par vos valeurs
# Trouvez ces infos dans : Supabase Dashboard → Settings → Database
# ============================================================

# ── Base de données PostgreSQL (Supabase) ──────────────────
# Transaction Pooler — Port 6543 (recommandé pour production avec PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Connection — Port 5432 (pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Serveur ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Authentification JWT ───────────────────────────────────
JWT_SECRET=b23e7522c733edf9eae0df06ae14c9d585dbd5717b5fbbc64f4153b53991e165
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=https://purple-cat-911761.hostingersite.com

# ── Supabase (optionnel — pour les fonctionnalités Storage/Auth Supabase) ─
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[VOTRE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[VOTRE_SERVICE_ROLE_KEY]

# ── Exemple de valeurs réelles (à remplacer) ───────────────
# DATABASE_URL="postgresql://postgres.abcdefghijklmn:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.abcdefghijklmn:motdepasse@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://abcdefghijklmn.supabase.co"
