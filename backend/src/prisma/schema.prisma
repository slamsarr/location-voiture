datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("CLIENT") // "CLIENT" | "ADMIN"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customers    Customer?
}

model Customer {
  id             String        @id @default(uuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  firstName      String
  lastName       String
  email          String
  phone          String
  licenseNumber  String
  licenseExpiry  String
  licenseCountry String        @default("Sénégal")
  address        String?
  city           String?
  country        String?       @default("Sénégal")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservations   Reservation[]
}

model VehicleCategory {
  id          String    @id @default(uuid())
  name        String    @unique // Économique, Compacte, Berline, SUV, Premium, Utilitaire
  slug        String    @unique
  description String?
  icon        String?
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vehicle {
  id              String              @id @default(uuid())
  brand           String
  model           String
  year            Int
  categoryId      String
  category        VehicleCategory     @relation(fields: [categoryId], references: [id])
  transmission    String              @default("MANUAL") // "MANUAL" | "AUTOMATIC"
  fuel            String              @default("DIESEL") // "GASOLINE" | "DIESEL" | "HYBRID" | "ELECTRIC"
  seats           Int                 @default(5)
  doors           Int                 @default(5)
  airConditioning Boolean             @default(true)
  pricePerDay     Float // In FCFA
  deposit         Float // Caution in FCFA
  mileagePolicy   String              @default("Kilométrage illimité")
  status          String              @default("AVAILABLE") // "AVAILABLE" | "RESERVED" | "RENTED" | "MAINTENANCE"
  imageUrl        String
  gallery         String? // JSON string array of URLs
  description     String
  features        String? // JSON string array of features
  plateNumber     String              @unique
  reservations    Reservation[]
  inspections     VehicleInspection[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Reservation {
  id              String              @id @default(uuid())
  reference       String              @unique // HZ-2026-XXXXX
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id])
  vehicleId       String
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  startDate       String // YYYY-MM-DD
  endDate         String // YYYY-MM-DD
  pickupTime      String              @default("10:00")
  returnTime      String              @default("10:00")
  pickupLocation  String              @default("Agence Aéroport Blaise Diagne (AIBD)")
  returnLocation  String              @default("Agence Aéroport Blaise Diagne (AIBD)")
  dailyRate       Float
  durationDays    Int
  subtotal        Float
  optionsTotal    Float               @default(0)
  taxTotal        Float               @default(0)
  totalAmount     Float
  depositAmount   Float
  status          String              @default("PENDING") // "PENDING" | "CONFIRMED" | "PAID" | "ACTIVE" | "COMPLETED" | "CANCELLED"
  options         ReservationOption[]
  payments        Payment[]
  contract        Contract?
  inspections     VehicleInspection[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ReservationOption {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String // "GPS", "CHILD_SEAT", "EXTRA_DRIVER", "FULL_INSURANCE", "DELIVERY"
  name          String
  pricePerDay   Float
  quantity      Int         @default(1)
  totalPrice    Float
}

model Payment {
  id                 String      @id @default(uuid())
  reference          String      @unique // PAY-2026-XXXXX
  reservationId      String
  reservation        Reservation @relation(fields: [reservationId], references: [id])
  amount             Float
  currency           String      @default("FCFA")
  method             String // "WAVE" | "ORANGE_MONEY" | "INTOUCH" | "CARD"
  provider           String      @default("MockPaymentProvider")
  status             String      @default("INITIATED") // "INITIATED" | "PENDING" | "SUCCESS" | "FAILED"
  transactionDetails String? // JSON details / mock payload
  paidAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Contract {
  id            String      @id @default(uuid())
  reference     String      @unique // CTR-2026-XXXXX
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  status        String      @default("ISSUED") // "DRAFT" | "ISSUED" | "SIGNED"
  signedAt      DateTime?
  termsAccepted Boolean     @default(true)
  pdfDataUrl    String? // Embedded base64 or generated document path
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  type      String // "EMAIL" | "SMS" | "WHATSAPP"
  recipient String
  subject   String?
  content   String
  status    String   @default("SENT") // "SENT" | "PENDING" | "FAILED"
  sentAt    DateTime @default(now())
}

model VehicleInspection {
  id             String       @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  type           String // "CHECK_IN" | "CHECK_OUT"
  mileage        Int
  fuelLevel      Int // 0 - 100 %
  damages        String? // JSON array of damage markers [{part: "front_bumper", severity: "minor", note: "scratch"}]
  photos         String? // JSON array of image URLs
  inspectorNotes String?
  completedAt    DateTime     @default(now())
}
