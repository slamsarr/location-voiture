// ======================================================================
// HERTZ DIGITAL RENTAL PLATFORM — Prisma Schema PostgreSQL (Supabase)
// ======================================================================
// Pour migrer vers Supabase :
//   1. Exécutez scripts/supabase-migration.sql dans le SQL Editor Supabase
//   2. Copiez ce fichier : cp schema.postgresql.prisma schema.prisma
//   3. Mettez à jour backend/.env avec les URLs Supabase
//   4. Exécutez : npx prisma generate
// ======================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum Transmission {
  AUTOMATIQUE
  MANUELLE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  CREDIT_CARD
  CASH
  BANK_TRANSFER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_RENTAL
  POST_RENTAL
}

enum NotificationType {
  RESERVATION_CONFIRMED
  PAYMENT_RECEIVED
  CONTRACT_READY
  REMINDER
  ADMIN_ALERT
  SYSTEM
}

model User {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer?
  notifications Notification[]
}

model VehicleCategory {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())

  vehicles    Vehicle[]
}

model Agency {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  city      String
  address   String?
  phone     String?
  email     String?
  latitude  Float?
  longitude Float?
  openHours String?
  createdAt DateTime @default(now())

  vehicles           Vehicle[]
  pickupReservations  Reservation[] @relation("PickupAgency")
  dropoffReservations Reservation[] @relation("DropoffAgency")
}

model Vehicle {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brand        String
  model        String
  year         Int
  plate        String        @unique
  color        String?
  categoryId   String        @db.Uuid
  dailyRate    Decimal       @db.Decimal(10, 2)
  weeklyRate   Decimal?      @db.Decimal(10, 2)
  monthlyRate  Decimal?      @db.Decimal(10, 2)
  mileage      Int           @default(0)
  fuel         String        @default("ESSENCE")
  transmission Transmission  @default(AUTOMATIQUE)
  seats        Int           @default(5)
  status       VehicleStatus @default(AVAILABLE)
  description  String?
  features     String[]
  images       String[]
  thumbnailUrl String?
  agencyId     String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category     VehicleCategory @relation(fields: [categoryId], references: [id])
  agency       Agency?         @relation(fields: [agencyId], references: [id])
  reservations Reservation[]
}

model Customer {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String?  @unique @db.Uuid
  firstName        String
  lastName         String
  email            String
  phone            String?
  licenseNumber    String?
  licenseExpiry    DateTime? @db.Date
  licenseCountry   String?  @default("Sénégal")
  licensePhotoUrl  String?
  address          String?
  city             String?
  country          String?  @default("Sénégal")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reference       String            @unique
  customerId      String            @db.Uuid
  vehicleId       String            @db.Uuid
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date
  pickupAgencyId  String?           @db.Uuid
  dropoffAgencyId String?           @db.Uuid
  days            Int
  dailyRate       Decimal           @db.Decimal(10, 2)
  subtotal        Decimal           @db.Decimal(10, 2)
  taxes           Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal           @db.Decimal(10, 2)
  driverRequired  Boolean           @default(false)
  driverFee       Decimal           @default(0) @db.Decimal(10, 2)
  insurance       String?
  insuranceFee    Decimal           @default(0) @db.Decimal(10, 2)
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  pickupAgency  Agency?       @relation("PickupAgency", fields: [pickupAgencyId], references: [id])
  dropoffAgency Agency?       @relation("DropoffAgency", fields: [dropoffAgencyId], references: [id])
  payments      Payment[]
  contract      Contract?
  inspections   Inspection[]
}

model Payment {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reference          String        @unique
  reservationId      String        @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("XOF")
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  transactionDetails Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model Contract {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reference     String         @unique
  reservationId String         @unique @db.Uuid
  content       String
  status        ContractStatus @default(DRAFT)
  signedAt      DateTime?
  pdfUrl        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model Inspection {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reservationId String         @db.Uuid
  type          InspectionType
  mileageIn     Int?
  mileageOut    Int?
  fuelLevelIn   Int?
  fuelLevelOut  Int?
  damages       Json?
  photos        String[]
  notes         String?
  inspectorId   String?        @db.Uuid
  createdAt     DateTime       @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
