# =============================================================
# Hertz Digital Rental Platform — Fichier de Configuration
# Copiez ce fichier en `.env` dans le dossier /backend ET/ou racine
# =============================================================

# --------------------------------------------------------------------
# GÉNÉRAL (OBLIGATOIRE EN PRODUCTION)
# --------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# URL publique de votre application (pour les liens dans les emails/contrats)
APP_URL=https://votre-domaine.tdl

# Origine(s) autorisée(s) pour CORS (séparées par virgule)
# Laisser "*" pour tout autoriser (défaut), ou restreindre :
# ALLOWED_ORIGINS=https://votre-domaine.tdl,https://www.votre-domaine.tdl
ALLOWED_ORIGINS=*

# --------------------------------------------------------------------
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# --------------------------------------------------------------------
# Générez une chaîne ALÉATOIRE et COMPLEXE. Exemple de commande :
#   Linux/Mac : openssl rand -hex 32
#   Windows   : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_TRES_LONG_ET_SECURISE

# Durée de validité des tokens JWT (7d = 7 jours, 24h = 24 heures, 30d = 30 jours)
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# BASE DE DONNÉES
# --------------------------------------------------------------------
# Option 1 : SQLite (plus simple, bon pour petit trafic — max ~100 réservations/jour)
# La base réside dans backend/dist/prisma/prod.db
DATABASE_URL="file:./dist/prisma/prod.db"

# Option 2 : PostgreSQL (RECOMMANDÉ pour Hostinger VPS/Cloud — performances, robustesse)
# Depuis le hPanel Hostinger → Bases de données → PostgreSQL → Créer une base
# Récupérer les identifiants et renseigner :
# DATABASE_URL="postgresql://USER_NOM:MOT_DE_PASSE@HOST_HOSTINGER:5432/NOM_BASE?schema=public"

# Option 3 : MySQL (si Hostinger ne propose pas PostgreSQL sur votre plan)
# DATABASE_URL="mysql://USER_NOM:MOT_DE_PASSE@HOST_HOSTINGER:3306/NOM_BASE"

# --------------------------------------------------------------------
# PROVIDERS DE PAIEMENT (optionnels — laisser "none" pour la démo)
# Nécessaires UNIQUEMENT si vous souhaitez activer les paiements RÉELS
# Pour la démo / tests, laissez "none" (MockPaymentProvider sera utilisé)
# --------------------------------------------------------------------
WAVE_API_KEY=none
WAVE_API_SECRET=none
WAVE_MERCHANT_ID=none

ORANGE_MONEY_MERCHANT_KEY=none
ORANGE_MONEY_MERCHANT_ID=none

INTOUCH_API_TOKEN=none
INTOUCH_PARTNER_ID=none

STRIPE_SECRET_KEY=none
STRIPE_PUBLISHABLE_KEY=none

# --------------------------------------------------------------------
# NOTIFICATIONS (optionnels — laisser "none" par défaut)
# --------------------------------------------------------------------
# SMTP pour l'envoi d'emails (ex: Hostinger Webmail, SendGrid, Mailgun, Gmail SMTP)
SMTP_HOST=none
SMTP_PORT=587
SMTP_USER=none
SMTP_PASS=none
SMTP_FROM=none

# Twilio / Infobip pour les SMS
SMS_API_KEY=none
SMS_SENDER_ID=none

# WhatsApp Business API (Meta Cloud / 360dialog)
WHATSAPP_API_TOKEN=none
WHATSAPP_PHONE_ID=none
