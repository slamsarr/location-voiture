# ===================================================
# Hertz Digital Rental Platform — .gitignore
# ===================================================

# --- Dépendances Node ---
node_modules/
*/node_modules/
**/node_modules/

# --- Build outputs ---
frontend/dist/
frontend/.vite/
backend/build/
*.tsbuildinfo

# --- Logs PM2 & Node ---
backend/logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2*.log

# --- Base de données SQLite ---
*.db
*.sqlite
*.sqlite3
backend/src/prisma/dev.db
backend/src/prisma/prod.db
backend/dist/prisma/*.db

# --- Variables d'environnement (JAMAIS COMMITER) ---
.env
.env.local
.env.production
.env.development
backend/.env
frontend/.env

# --- OS & IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Lock fichiers alternatifs ---
# (garder package-lock.json car c'est le standard npm)
# yarn.lock
# pnpm-lock.yaml
