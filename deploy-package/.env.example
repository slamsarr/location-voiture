# =============================================================
# Hertz Digital Rental Platform — backend/.env
# Copiez ce fichier en `.env` dans /backend
# Ce fichier est chargé en PREMIER par le server.ts compilé
# =============================================================

# --------------------------------------------------------------------
# GÉNÉRAL (OBLIGATOIRE)
# --------------------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_URL=https://votre-domaine.tdl
ALLOWED_ORIGINS=https://votre-domaine.tdl,https://www.votre-domaine.tdl

# --------------------------------------------------------------------
# SÉCURITÉ (OBLIGATOIRE)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------
JWT_SECRET=A_DEFINIR_SECRET_ALEATOIRE_64_CARACTERES_HEX_MINIMUM
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# BASE DE DONNÉES
# --------------------------------------------------------------------
# OPTION 1 - SQLite (débutant, petit trafic) :
DATABASE_URL="file:./dist/prisma/prod.db"

# OPTION 2 - PostgreSQL Hostinger VPS (RECOMMANDÉ) :
# DATABASE_URL="postgresql://USER:MDP@localhost:5432/NOM_BASE?schema=public"

# OPTION 3 - MySQL Hostinger Web Hosting :
# DATABASE_URL="mysql://USER:MDP@localhost:3306/NOM_BASE"

# --------------------------------------------------------------------
# PAIEMENTS (OPTIONNELS, laisser "none" pour la démo)
# --------------------------------------------------------------------
WAVE_API_KEY=none
WAVE_API_SECRET=none
WAVE_MERCHANT_ID=none
ORANGE_MONEY_MERCHANT_KEY=none
ORANGE_MONEY_MERCHANT_ID=none
INTOUCH_API_TOKEN=none
INTOUCH_PARTNER_ID=none
STRIPE_SECRET_KEY=none
STRIPE_PUBLISHABLE_KEY=none

# --------------------------------------------------------------------
# NOTIFICATIONS (OPTIONNELS, laisser "none")
# --------------------------------------------------------------------
SMTP_HOST=none
SMTP_PORT=587
SMTP_USER=none
SMTP_PASS=none
SMTP_FROM=none
SMS_API_KEY=none
SMS_SENDER_ID=none
WHATSAPP_API_TOKEN=none
WHATSAPP_PHONE_ID=none
